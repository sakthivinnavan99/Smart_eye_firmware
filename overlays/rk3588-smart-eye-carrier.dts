/dts-v1/;
/plugin/;

/ {
	metadata {
		title = "Smart Eye Custom Carrier Board";
		compatible = "radxa,cm5-io";
		category = "misc";
		exclusive = "GPIO4_B3\0GPIO3_B7\0GPIO3_C0\0GPIO4_A4\0GPIO1_D1\0GPIO1_D0\0GPIO0_D3\0GPIO0_D0\0GPIO0_C7\0GPIO4_A3\0GPIO1_C0";
		description = "Enable peripherals for Smart Eye custom carrier board:\n  - PWM15-M1 (GPIO4_B3) vibration motor\n  - I2C3-M1 (GPIO3_B7 SCL / GPIO3_C0 SDA) BQ27220 fuel gauge\n  - GPIO4_A4 fuel gauge interrupt\n  - UART6-M2 (GPIO1_D1 TX / GPIO1_D0 RX) serial\n  - GPIO0_D3 CHG_INT0_L charger interrupt\n  - GPIO0_D0 LANG_BTN, GPIO0_C7 OCR_BTN\n  - Audio: ES8316 headphone + MAX98357A speaker on I2S0\n  - GPIO4_A3 speaker amp enable, GPIO1_C0 headphone detect";
	};

	/*
	 * PWM15-M1: Vibration motor on GPIO4_B3.
	 *
	 * No gpio-hog here -- it conflicts with the PWM pinctrl claim
	 * on the same pin, causing neither driver to claim it.
	 *
	 * IMPORTANT: A gate pull-down resistor (47K-100K to GND) is
	 * required on the MOSFET gate to keep the motor off during
	 * early boot before the PWM driver loads.
	 */
	fragment@0 {
		target = <&pwm15>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&pwm15m1_pins>;
		};
	};

	/* I2C3-M1: BQ27220YZFR fuel gauge on GPIO3_B7 (SCL) / GPIO3_C0 (SDA) */
	fragment@1 {
		target = <&i2c3>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&i2c3m1_xfer>;
			#address-cells = <1>;
			#size-cells = <0>;

			bq27220: fuel-gauge@55 {
				compatible = "ti,bq27220";
				reg = <0x55>;
				interrupt-parent = <&gpio4>;
				interrupts = <4 2>; /* GPIO4_A4, IRQ_TYPE_EDGE_FALLING */
			};
		};
	};

	/* GPIO pin configurations for interrupts, buttons, and audio */
	fragment@2 {
		target = <&pinctrl>;
		__overlay__ {
			bq27220 {
				bq27220_int: bq27220-int {
					rockchip,pins = <4 4 0 &pcfg_pull_up>;
				};
			};
			charger {
				chg_int0: chg-int0 {
					rockchip,pins = <0 27 0 &pcfg_pull_up>;
				};
			};
			buttons {
				lang_btn: lang-btn {
					rockchip,pins = <0 24 0 &pcfg_pull_up>;
				};
				ocr_btn: ocr-btn {
					rockchip,pins = <0 23 0 &pcfg_pull_up>;
				};
			};
			audio-amp {
				amp_sd_pin: amp-sd-pin {
					rockchip,pins = <4 3 0 &pcfg_pull_none>;
				};
			};
		};
	};

	/* UART6-M2: Serial port on GPIO1_D1 (TX) / GPIO1_D0 (RX) */
	fragment@3 {
		target = <&uart6>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&uart6m2_xfer>;
		};
	};

	/* GPIO keys: LANG_BTN (GPIO0_D0) and OCR_BTN (GPIO0_C7) */
	fragment@4 {
		target-path = "/";
		__overlay__ {
			smart-eye-keys {
				compatible = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <&lang_btn &ocr_btn>;

				lang-button {
					label = "LANG_BTN";
					linux,code = <0x100>; /* BTN_MISC */
					gpios = <&gpio0 24 1>; /* GPIO0_D0, active low */
					debounce-interval = <50>;
				};

				ocr-button {
					label = "OCR_BTN";
					linux,code = <0x101>; /* BTN_1 */
					gpios = <&gpio0 23 1>; /* GPIO0_C7, active low */
					debounce-interval = <50>;
				};
			};

			/* CHG_INT0_L: Charger interrupt on GPIO0_D3, active low */
			smart-eye-chg-int {
				compatible = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <&chg_int0>;

				chg-interrupt {
					label = "CHG_INT0_L";
					linux,code = <0x102>; /* BTN_2 */
					gpios = <&gpio0 27 1>; /* GPIO0_D3, active low */
					debounce-interval = <10>;
				};
			};

			/*
			 * MAX98357A speaker amplifier (I2S DAC, no I2C).
			 * SD_MODE on GPIO4_A3 controls enable/shutdown.
			 */
			max98357a: max98357a {
				compatible = "maxim,max98357a";
				#sound-dai-cells = <0>;
				sdmode-gpios = <&gpio4 3 0>; /* GPIO4_A3, active high */
				sdmode-delay = <100>;
			};
		};
	};

	/*
	 * Disable the CM5-IO es8316-sound card.
	 * Replaced by a dual-codec card with ES8316 + MAX98357A.
	 */
	fragment@5 {
		target-path = "/es8316-sound";
		__overlay__ {
			status = "disabled";
		};
	};

	/*
	 * Dual-codec sound card: ES8316 + MAX98357A on I2S0.
	 */
	fragment@6 {
		target-path = "/";
		__overlay__ {
			smart-eye-sound {
				status = "okay";
				compatible = "rockchip,multicodecs-card";
				rockchip,card-name = "Smart-Eye-Audio";
				rockchip,format = "i2s";
				rockchip,mclk-fs = <256>;
				rockchip,cpu = <&i2s0_8ch>;
				rockchip,codec = <&es8316>, <&max98357a>;
				pinctrl-names = "default";
				pinctrl-0 = <&hp_det &amp_sd_pin>;

				hp-det-gpio = <&gpio1 16 0>; /* GPIO1_C0, active high */
				spk-con-gpio = <&gpio4 3 0>; /* GPIO4_A3, active high */

				io-channels = <&saradc 3>;
				io-channel-names = "adc-detect";
				keyup-threshold-microvolt = <1800000>;
				poll-interval = <100>;

				play-pause-key {
					label = "playpause";
					linux,code = <164>; /* KEY_PLAYPAUSE */
					press-threshold-microvolt = <2000>;
				};
			};
		};
	};
};
