/dts-v1/;
/plugin/;

/ {
	metadata {
		title = "Smart Eye Custom Carrier Board";
		compatible = "radxa,cm5-io";
		category = "misc";
		exclusive = "GPIO4_B3\0GPIO4_B4\0GPIO3_B7\0GPIO3_C0\0GPIO4_A4\0GPIO1_D1\0GPIO1_D0\0GPIO0_D3\0GPIO0_D0\0GPIO0_C7";
		description = "Enable peripherals for Smart Eye custom carrier board:\n  - PWM15-M1 (GPIO4_B3) for vibration motor (disables CM5-IO activity LED on GPIO4_B4)\n  - I2C3-M1 (GPIO3_B7 SCL / GPIO3_C0 SDA) for BQ27220 fuel gauge\n  - GPIO4_A4 as fuel gauge interrupt/alert\n  - UART6-M2 (GPIO1_D1 TX / GPIO1_D0 RX) for serial communication\n  - GPIO0_D3 CHG_INT0_L charger interrupt\n  - GPIO0_D0 LANG_BTN language select button\n  - GPIO0_C7 OCR_BTN OCR trigger button";
	};

	/*
	 * Disable the CM5-IO activity LED (GPIO4_B4).
	 * The base DTB's gpio-leds node drives GPIO4_B4 with a heartbeat trigger.
	 * On the custom carrier this pin region is repurposed.
	 */
	fragment@0 {
		target-path = "/gpio-leds";
		__overlay__ {
			status = "disabled";
		};
	};

	/*
	 * GPIO4_B3 defaults high at boot (RK3588 power-on / U-Boot state),
	 * which drives the vibration motor on. Use a gpio-hog on the gpio4
	 * controller to force it low as early as possible in the boot sequence,
	 * before the PWM driver is ready to take over the pin mux.
	 */
	fragment@1 {
		target = <&gpio4>;
		__overlay__ {
			vibration-motor-off-hog {
				gpio-hog;
				gpios = <11 0>; /* GPIO4_B3, active high */
				output-low;
				line-name = "vibration-motor-off";
			};
		};
	};

	/* PWM15-M1: Vibration motor on GPIO4_B3 */
	fragment@2 {
		target = <&pwm15>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&pwm15m1_pins>;
		};
	};

	/* I2C3-M1: BQ27220YZFR fuel gauge on GPIO3_B7 (SCL) / GPIO3_C0 (SDA) */
	fragment@3 {
		target = <&i2c3>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&i2c3m1_xfer>;
			#address-cells = <1>;
			#size-cells = <0>;

			bq27220: fuel-gauge@55 {
				compatible = "ti,bq27220";
				reg = <0x55>;
				interrupt-parent = <&gpio4>;
				interrupts = <4 2>; /* GPIO4_A4, IRQ_TYPE_EDGE_FALLING */
			};
		};
	};

	/* GPIO pin configurations for interrupts and buttons */
	fragment@4 {
		target = <&pinctrl>;
		__overlay__ {
			bq27220 {
				bq27220_int: bq27220-int {
					rockchip,pins = <4 4 0 &pcfg_pull_up>;
				};
			};
			charger {
				chg_int0: chg-int0 {
					rockchip,pins = <0 27 0 &pcfg_pull_up>;
				};
			};
			buttons {
				lang_btn: lang-btn {
					rockchip,pins = <0 24 0 &pcfg_pull_up>;
				};
				ocr_btn: ocr-btn {
					rockchip,pins = <0 23 0 &pcfg_pull_up>;
				};
			};
		};
	};

	/* UART6-M2: Serial port on GPIO1_D1 (TX) / GPIO1_D0 (RX) */
	fragment@5 {
		target = <&uart6>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&uart6m2_xfer>;
		};
	};

	/* GPIO keys: LANG_BTN (GPIO0_D0) and OCR_BTN (GPIO0_C7) */
	fragment@6 {
		target-path = "/";
		__overlay__ {
			smart-eye-keys {
				compatible = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <&lang_btn &ocr_btn>;

				lang-button {
					label = "LANG_BTN";
					linux,code = <0x100>; /* BTN_MISC - userspace maps this */
					gpios = <&gpio0 24 1>; /* GPIO0_D0, active low */
					debounce-interval = <50>;
				};

				ocr-button {
					label = "OCR_BTN";
					linux,code = <0x101>; /* BTN_1 */
					gpios = <&gpio0 23 1>; /* GPIO0_C7, active low */
					debounce-interval = <50>;
				};
			};

			/* CHG_INT0_L: Charger interrupt on GPIO0_D3, active low */
			smart-eye-chg-int {
				compatible = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <&chg_int0>;

				chg-interrupt {
					label = "CHG_INT0_L";
					linux,code = <0x102>; /* BTN_2 */
					gpios = <&gpio0 27 1>; /* GPIO0_D3, active low */
					debounce-interval = <10>;
				};
			};
		};
	};
};
