/dts-v1/;
/plugin/;

/ {
	metadata {
		title = "Smart Eye Custom Carrier Board";
		compatible = "radxa,cm5-io";
		category = "misc";
		exclusive = "GPIO0_C5\0GPIO3_B7\0GPIO3_C0\0GPIO4_A4\0GPIO4_A5\0GPIO4_A6\0GPIO1_D1\0GPIO1_D0\0GPIO0_D3\0GPIO0_D0\0GPIO0_C7\0GPIO4_A3\0GPIO4_A1\0GPIO4_A2\0GPIO4_B2\0GPIO0_A0";
		description = "Enable peripherals for Smart Eye custom carrier board:\n  - PWM4-M0 (GPIO0_C5) vibration motor\n  - I2C3-M1 (GPIO3_B7 SCL / GPIO3_C0 SDA) BQ27220 fuel gauge + BQ25895 charger\n  - GPIO4_A4 fuel gauge GPOUT interrupt\n  - UART3-M2 (GPIO4_A5 TX / GPIO4_A6 RX) front ultrasonic (US-front)\n  - UART6-M2 (GPIO1_D1 TX / GPIO1_D0 RX) bottom ultrasonic (US-down)\n  - GPIO0_D3 CHG_INT0_L charger interrupt\n  - GPIO0_D0 LANG_BTN, GPIO0_C7 OCR_BTN\n  - Speaker: MAX98357A on I2S1-M0 (SD_MODE via BSS138 on GPIO4_A3)\n  - Headphone: ES8316 codec on I2S0 + I2C8-M2 (hp-det-gpio jack detect)\n  - GPIO0_A0 HP_INT pull-up (ES8316 GPIO3 open-drain; R29=0R, no PCB pull-up)\n  - I2S1 trcm-sync-tx-only: BCLK+LRCLK stop together (DC protection)";
	};

	/*
	 * Vibration motor on GPIO0_C5 (PWM4-M0, controller at 0xfebd0000).
	 *
	 * GPIO0_C5 muxes to PWM4 in M0 mode (mux function 1).  The PWM4
	 * controller is the first channel of the febd0000 PWM block
	 * (pwm4=febd0000, pwm5=febd0010, pwm6=febd0020, pwm7=febd0030).
	 *
	 * We use a custom vib_pwm4m0 pin group (defined in fragment@2) instead
	 * of the stock pwm4m0_pins so we can add pcfg_pull_down.  The pull-down
	 * holds GPIO0_C5 LOW during early boot — before the PWM driver claims
	 * the pin — preventing the motor from staying on until the OS is up.
	 */
	fragment@0 {
		target = <&pwm4>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&vib_pwm4m0>;
		};
	};

	/*
	 * I2C3-M1: Power management ICs on GPIO3_B7 (SCL) / GPIO3_C0 (SDA)
	 *   0x55 - BQ27220YZFR  fuel gauge (U20)
	 *   0x6A - BQ25895RTWR  charger    (U2)
	 */
	fragment@1 {
		target = <&i2c3>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&i2c3m1_xfer>;
			#address-cells = <1>;
			#size-cells = <0>;

			bq27220: fuel-gauge@55 {
				compatible = "ti,bq27220";
				reg = <0x55>;
				pinctrl-names = "default";
				pinctrl-0 = <&bq27220_int>;
				interrupt-parent = <&gpio4>;
				interrupts = <4 2>; /* GPIO4_A4, IRQ_TYPE_EDGE_FALLING */
			};

			bq25895: charger@6a {
				compatible = "ti,bq25895";
				reg = <0x6a>;
				pinctrl-names = "default";
				pinctrl-0 = <&chg_int0>;
				interrupt-parent = <&gpio0>;
				interrupts = <27 2>; /* GPIO0_D3, IRQ_TYPE_EDGE_FALLING */
				ti,battery-regulation-voltage = <4208000>; /* uV */
				ti,charge-current = <2048000>;             /* uA */
				ti,termination-current = <256000>;         /* uA */
				ti,precharge-current = <256000>;           /* uA */
				ti,minimum-sys-voltage = <3500000>;        /* uV */
				ti,boost-voltage = <5126000>;              /* uV */
				ti,boost-max-current = <1400000>;          /* uA */
			};
		};
	};

	/* GPIO pin configurations for interrupts, buttons, and audio */
	fragment@2 {
		target = <&pinctrl>;
		__overlay__ {
			bq27220 {
				bq27220_int: bq27220-int {
					rockchip,pins = <4 4 0 &pcfg_pull_up>;
				};
			};
			charger {
				chg_int0: chg-int0 {
					rockchip,pins = <0 27 0 &pcfg_pull_up>;
				};
			};
			buttons {
				lang_btn: lang-btn {
					rockchip,pins = <0 24 0 &pcfg_pull_up>;
				};
				ocr_btn: ocr-btn {
					rockchip,pins = <0 23 0 &pcfg_pull_up>;
				};
			};
			audio-amp {
				amp_sd_pin: amp-sd-pin {
					/* pull-down keeps SD_MODE LOW (amp OFF) when GPIO is undriven */
					rockchip,pins = <4 3 0 &pcfg_pull_down>;
				};
			};
			headphone-int {
				hp_int_pull: hp-int-pull {
					/*
					 * GPIO0_A0 = HP_INT from ES8316 GPIO3.
					 * ES8316 GPIO3 is open-drain: LOW=HP inserted, HI-Z=no HP.
					 * Custom carrier board has no pull-up resistor (R29=0Ω series
					 * only), so without bias-pull-up the line floats at ~0.88V
					 * instead of 1.8V.  Enable the SoC internal ~50KΩ pull-up here
					 * as a software workaround until a 10KΩ to VCC_1V8 is added.
					 */
					rockchip,pins = <0 0 0 &pcfg_pull_up>;
				};
			};
			vibration {
				vib_pwm4m0: vib-pwm4m0 {
					/* GPIO0_C5 (bank=0, pin=21) in PWM4-M0 mux (func 1).
					 * pull-down holds pin LOW during early boot so the
					 * motor stays off before the PWM driver takes over. */
					rockchip,pins = <0 21 1 &pcfg_pull_down>;
				};
			};
		};
	};

	/*
	 * UART3-M2: Front ultrasonic sensor (US-front) on GPIO4_A5 (TX) / GPIO4_A6 (RX)
	 *
	 * Maps to /dev/ttyS3 in the OS.
	 */
	fragment@3 {
		target = <&uart3>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&uart3m2_xfer>;
		};
	};

	/*
	 * UART6-M2: Bottom ultrasonic sensor (US-down) on GPIO1_D1 (TX) / GPIO1_D0 (RX)
	 *
	 * Maps to /dev/ttyS6 in the OS.
	 */
	fragment@3a {
		target = <&uart6>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&uart6m2_xfer>;
		};
	};

	/* GPIO keys: LANG_BTN (GPIO0_D0) and OCR_BTN (GPIO0_C7) */
	fragment@4 {
		target-path = "/";
		__overlay__ {
			smart-eye-keys {
				compatible = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <&lang_btn &ocr_btn &hp_int_pull>;

				lang-button {
					label = "LANG_BTN";
					linux,code = <0x100>; /* BTN_MISC */
					gpios = <&gpio0 24 1>; /* GPIO0_D0, active low */
					debounce-interval = <50>;
				};

				ocr-button {
					label = "OCR_BTN";
					linux,code = <0x101>; /* BTN_1 */
					gpios = <&gpio0 23 1>; /* GPIO0_C7, active low */
					debounce-interval = <50>;
				};
			};

			/*
			 * MAX98357A speaker amplifier (I2S DAC, no I2C).
			 *
			 * SD_MODE is NOT managed by the kernel driver here.
			 * The kernel's DAPM shutdown path leaves I2S BCLK
			 * running for ~3 s after the PCM stream closes,
			 * creating the dangerous BCLK-without-LRCLK state
			 * that produces DC on the speaker outputs.
			 *
			 * Instead, the application (main.py AudioPlayer)
			 * controls GPIO4_A3 via sysfs, pulling SD_MODE LOW
			 * the instant aplay exits — before the I2S clocks
			 * enter the invalid state.
			 */
			max98357a: max98357a {
				compatible = "maxim,max98357a";
				#sound-dai-cells = <0>;
				pinctrl-names = "default";
				pinctrl-0 = <&amp_sd_pin>;
				status = "okay";
			};
		};
	};

	/*
	 * ES8316 Headphone Codec (I2C8-M2 @ 0x11, I2S0 DAI)
	 *
	 * The base DTB (rk3588s-radxa-cm5-io.dtb) already has:
	 *   - i2c8 enabled with i2c8m2-xfer pinctrl (GPIO1_D6/D7 SCL/SDA)
	 *   - es8316@11 node (status=okay) with working clock configuration
	 *   - es8316-sound (rockchip,multicodecs-card) machine driver
	 *
	 * **Do NOT override i2c8 or add duplicate es8316 nodes** — modifying the
	 * i2c8 node in an overlay corrupts phandle references and prevents the
	 * pinctrl from being applied, leaving GPIO1_D6/D7 in plain GPIO mode
	 * instead of I2C mode. The I2C bus becomes completely non-functional.
	 *
	 * Simply ensure es8316-sound and i2s0_8ch are enabled (they are in the
	 * base DTB, but we confirm here for completeness).
	 */

	fragment@5 {
		target-path = "/es8316-sound";
		__overlay__ {
			status = "okay";
			/*
			 * rockchip,hp-det-gpio is intentionally omitted here.
			 *
			 * The rk-multicodecs driver accepts the property and claims
			 * GPIO0_A0 via gpiod (blocking sysfs access), but never
			 * actually registers a functioning GPIO IRQ — it declares
			 * SW_HEADPHONE_INSERT capability on the input device yet
			 * never fires the event on plug/unplug.
			 *
			 * Leaving GPIO0_A0 free allows audio-router.py to poll it
			 * directly via /sys/class/gpio with a 500 ms debounce, which
			 * is the only reliable detection method on this BSP.
			 */
		};
	};

	fragment@5a {
		target = <&i2s0_8ch>;
		__overlay__ {
			status = "okay";
		};
	};

	/*
	 * I2S1 Speaker Output (MAX98357A Amplifier)
	 *
	 * I2S1 (fe480000) carries audio to the MAX98357A amplifier via:
	 *   GPIO4_A1 (pin 129) = SCLK (bit clock) via i2s1m0-sclk
	 *   GPIO4_A2 (pin 130) = LRCK (frame/sample clock) via i2s1m0-lrck
	 *   GPIO4_B2 (pin 138) = SDO1 (stereo audio data) via i2s1m0-sdo1
	 *
	 * Pin Conflict Workaround:
	 *   The base DTB specifies all 10 i2s1m0 pin groups, but several
	 *   conflict with other peripherals:
	 *     - i2s1m0-sdo0 (GPIO4_B0) is claimed by I2C6-M3 (fec80000.i2c)
	 *     - i2s1m0-sdi0 (GPIO4_A5) conflicts with UART3-M2 TX
	 *     - i2s1m0-sdi1 (GPIO4_A6) conflicts with UART3-M2 RX
	 *   When the kernel tries to apply conflicting groups, the entire
	 *   pinctrl application fails — ALL I2S1 pins revert to GPIO mode.
	 *   Solution: override pinctrl-0 with only the 3 output groups needed
	 *   for the MAX98357A DAC (sclk, lrck, sdo1). SDI pins are input-only
	 *   and not needed for speaker playback.
	 *
	 * LRCK Signal Generation Fix:
	 *   The base DTB includes i2s-lrck-gpio which tells the RK3588 BSP
	 *   driver to monitor LRCK via GPIO polling, not generate it as part
	 *   of the I2S protocol. This breaks I2S1 operation (no LRCK signal
	 *   → codec cannot sync to audio frames). Override with null GPIO
	 *   (phandle 0) to disable GPIO-based monitoring and let I2S1 generate
	 *   LRCK as a real signal on GPIO4_A2 (pin 130).
	 *
	 * BCLK-LRCK Synchronization:
	 *   rockchip,trcm-sync-tx-only forces both BCLK and LRCK to stop
	 *   simultaneously when playback stops. Without this, BCLK can free-run
	 *   after LRCK drops, creating the dangerous state where DC appears on
	 *   the speaker outputs (max98357a_soft_shutdown_power_control_pin comment).
	 *
	 * Stereo Routing:
	 *   i2s-tx-route = <1 0 2 3> routes stereo channels to SDO1 (not SDO0),
	 *   which is the only output pin connected to the MAX98357A DIN.
	 */
	fragment@6 {
		target = <&i2s1_8ch>;
		__overlay__ {
			status = "okay";
			/delete-property/ i2s-lrck-gpio;
			rockchip,i2s-tx-route = <1 0 2 3>;
			rockchip,i2s-rx-route = <0 1 2 3>;
			rockchip,trcm-sync-tx-only;
			pinctrl-names = "default";
			pinctrl-0 = <&i2s1m0_sclk
				     &i2s1m0_lrck
				     &i2s1m0_sdo1>;
		};
	};

	/*
	 * Speaker sound card via MAX98357A on I2S1.
	 * CPU (I2S1) is bitclock + frame master.
	 */
	fragment@7 {
		target-path = "/";
		__overlay__ {
			smart-eye-sound {
				status = "okay";
				compatible = "simple-audio-card";
				simple-audio-card,name = "Smart-Eye-Audio";
				simple-audio-card,format = "i2s";
				simple-audio-card,mclk-fs = <256>;
				simple-audio-card,bitclock-master = <&spk_cpu>;
				simple-audio-card,frame-master = <&spk_cpu>;

				spk_cpu: simple-audio-card,cpu {
					sound-dai = <&i2s1_8ch>;
				};

				simple-audio-card,codec {
					sound-dai = <&max98357a>;
				};
			};
		};
	};

	/*
	 * USB Type-C role switch and OTG VBUS handling are intentionally NOT
	 * done here.  They were previously fragment@8/@9/@10, but those added
	 * three external dependencies that this base DTB does not export the
	 * same way:
	 *     - symbol  usbdrd_dwc3_0   (fragment@8 usb-role-switch phandle)
	 *     - path    /i2c@fec80000/fusb302@22
	 *     - path    /syscon@fd5d0000/usb2-phy@0/otg-port
	 * U-Boot's `fdt apply` is all-or-nothing: a single unresolved symbol
	 * or missing target path makes it drop the ENTIRE overlay, which took
	 * i2c3 (fuel gauge/charger), the MAX98357A speaker card, the vibration
	 * pinctrl and the UARTs down with it.
	 *
	 * The USB Type-C fix therefore lives entirely in the base DTB patches
	 * (Overlays/BASE_DTB_PATCH.md, applied by setup_device.sh --phase=3):
	 *   Patch 2 - remove fusb302 vbus-supply (GPIO4_A5/UART3 conflict)
	 *   Patch 3 - remove TCPM connector deadlocks AND add
	 *             usb-role-switch = <&usbdrd_dwc3_0> directly to fusb302@22
	 * plus removing rk3588-dwc3-peripheral.dtbo from extlinux.conf so DWC3
	 * runs in OTG mode and registers fc000000.usb-role-switch.  In the base
	 * DTB those symbols/paths resolve natively, so there is no fragile
	 * overlay fixup that can take the whole overlay down.
	 */
};
